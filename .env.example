# Copy to .env and fill in.

# Required. Create at https://huggingface.co/settings/tokens with the
# "Inference Providers" permission.
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxx

# Vision + tool calling are both required. Confirm your choice with:
#   python scripts/check_model.py --model <id>
HF_MODEL=Qwen/Qwen3-VL-8B-Instruct

# Optional: pin a specific serving provider (novita, together, fireworks-ai, ...).
# Leave unset to let the HF router choose. Worth setting, because function-calling
# support for a given model varies between providers.
# HF_PROVIDER=novita

# Optional: point at any other OpenAI-compatible endpoint, e.g. a local vLLM server.
# HF_BASE_URL=http://localhost:8000/v1
